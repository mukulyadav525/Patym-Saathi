# Backend environment (copy to backend/.env). Never commit real values.
APP_ENV=development
# Local Postgres by default; for Supabase use the Session pooler / direct URL:
# postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg://localhost/paytm_saathi?host=/tmp
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
JWT_SECRET=
SUPABASE_JWT_SECRET=
DEMO_MODE=true
DEMO_SHORTAGE=true
DEMO_WEBHOOK_KEY=
# Password for the seeded demo users (owner@sharma.demo, owner@storeb.demo)
DEMO_PASSWORD=saathi-demo-2026
RESTOCK_SAFETY_PACKS=0
PAYTM_ENV=demo
PAYTM_MID=
PAYTM_MERCHANT_KEY=
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_LLM_MODEL=sarvam-m
