# Backend environment (copy to backend/.env). Never commit real values.
APP_ENV=development
# Local Postgres by default. For Supabase use the SESSION pooler (port 5432, IPv4), not the transaction
# pooler (6543, breaks psycopg prepared statements). Pick a region near your users (ap-south-1 / ap-southeast-1):
# postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://localhost/paytm_saathi?host=/tmp
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
JWT_SECRET=
DEMO_MODE=true
DEMO_SHORTAGE=true
DEMO_WEBHOOK_KEY=
# Password for the seeded demo users (owner@sharma.demo, owner@storeb.demo)
DEMO_PASSWORD=saathi-demo-2026
RESTOCK_SAFETY_PACKS=0
PAYTM_ENV=demo
PAYTM_MID=
PAYTM_MERCHANT_KEY=
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=translit
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_LLM_MODEL=sarvam-105b
# Proactive Saathi check: drafts restock/collection tasks for approval. 0 = off, 1440 = daily.
AGENT_SCAN_INTERVAL_MIN=0
